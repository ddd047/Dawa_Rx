# DawaRx Backend — Environment Variables
# ✅ Fully offline — NO API KEY required.
# All OCR is handled locally by microsoft/trocr-large-handwritten.

# TrOCR model name (HuggingFace — downloaded and cached on first run)
# Options: microsoft/trocr-base-handwritten | microsoft/trocr-large-handwritten (recommended)
TROCR_MODEL=microsoft/trocr-large-handwritten

# Device for TrOCR inference: "cpu" or "cuda" (if you have a GPU)
TROCR_DEVICE=cpu

# API URL exposed to frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
